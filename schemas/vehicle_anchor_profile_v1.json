{
  "schema_id": "vehicle_anchor_profile_v1",
  "type": "object",
  "required": [
    "profile_version",
    "profile_id",
    "display_name",
    "category",
    "reference_image",
    "anchors"
  ],
  "additionalProperties": false,
  "properties": {
    "profile_version": {
      "type": "integer",
      "enum": [1]
    },
    "profile_id": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_]*$"
    },
    "display_name": {
      "type": "string"
    },
    "category": {
      "type": "string",
      "enum": ["FORMULA", "SPORTS", "GT", "HYPER"]
    },
    "reference_image": {
      "type": "object",
      "required": ["path", "expected_source_size_px"],
      "additionalProperties": false,
      "properties": {
        "path": {
          "type": "string",
          "pattern": "^res://assets/reference/vehicles/[a-z0-9_]+_reference\\.png$"
        },
        "expected_source_size_px": {
          "type": "array",
          "minItems": 2,
          "maxItems": 2,
          "items": {
            "type": "integer",
            "minimum": 1
          }
        }
      }
    },
    "anchors": {
      "type": "object"
    }
  }
}
